# Copy this file to backend.tf after creating the bootstrap state bucket.
# Replace the bucket name with the value of terraform_state_bucket_name.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_BOOTSTRAP_BUCKET_NAME"
    key          = "task-manager/dev/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
